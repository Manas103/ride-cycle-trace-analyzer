<Window x:Class="RideCycleTraceAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ride Cycle Trace Analyzer" Height="650" Width="950">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="OpenButton" Content="Open trace CSV..." Padding="8,4" Click="OpenButton_Click"/>
            <TextBlock x:Name="StatusText" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="200"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <GroupBox Header="Per-phase dwell (dispatch intervals are the DISPATCH row's dwell)" Grid.Row="0">
                <Canvas x:Name="DwellChart" Background="White"/>
            </GroupBox>

            <GroupBox Header="Phases" Grid.Row="1" Margin="0,10,0,0">
                <DataGrid x:Name="PhaseGrid" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Phase" Binding="{Binding Phase}" Width="*"/>
                        <DataGridTextColumn Header="Dwell (ms)" Binding="{Binding DwellMs}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Header="Violations (timing-envelope and interlock, exact triggering sample)" Grid.Row="2" Margin="0,10,0,0">
                <DataGrid x:Name="ViolationGrid" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="140"/>
                        <DataGridTextColumn Header="Phase" Binding="{Binding Phase}" Width="140"/>
                        <DataGridTextColumn Header="Sample #" Binding="{Binding SampleIndex}" Width="90"/>
                        <DataGridTextColumn Header="Value (ms)" Binding="{Binding ValueMs}" Width="100"/>
                        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
